{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (Backend API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/src/RegistrationApi/bin/Debug/net9.0/RegistrationApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/RegistrationApi",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "KeyVaultName": "${input:keyVaultName}",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": ""
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Frontend (Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/src/ui",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "serverReadyAction": {
        "pattern": "Local:\\s+(http://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Frontend)",
      "configurations": [
        ".NET Core Launch (Backend API)",
        "Launch Frontend (Vite)"
      ],
      "presentation": {
        "hidden": false,
        "group": "Full Stack",
        "order": 1
      }
    }
  ],
  "inputs": [
    {
      "id": "keyVaultName",
      "type": "promptString",
      "description": "Enter your Azure Key Vault name (e.g., kv-inspector-dev)",
      "default": "kv-inspector-dev"
    }
  ]
}
